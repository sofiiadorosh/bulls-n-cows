    "first",
    "jest",
    "big o",
    "eslint",
    "prettier",
    "husky"
  ],
  "homepage": "https://github.com/sofiiadorosh/bulls-n-cows#readme",
  "bugs": {
    "url": "https://github.com/sofiiadorosh/bulls-n-cows/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sofiiadorosh/bulls-n-cows.git"
  },
  "author": "Sofiia Dorosh",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
